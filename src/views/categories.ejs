<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
        <h2>Service Project Categories</h2>
        <ul>
            <% categories.forEach(category => { %>
            <li>
                 <a href="/category/<%= category.category_id %>">
                    <%= category.name %>
                </a>
                <a href="/edit-category/<%= category.category_id %>">Edit</a>
            </li>
        <% }); %>
        </ul>
        <a href="/new-category">Create New Category</a>
 </main>
<%- include('partials/footer') %>